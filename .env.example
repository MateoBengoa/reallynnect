# Backend / workers (copiar a backend/.env o raíz según despliegue)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cifrado li_at y secretos proxy (32+ caracteres recomendado)
COOKIE_ENCRYPTION_KEY=

# Cola sin Redis (local): USE_IN_MEMORY_QUEUE=true o REDIS_URL=memory
USE_IN_MEMORY_QUEUE=true
REDIS_URL=redis://127.0.0.1:6379
# Con Redis real: USE_IN_MEMORY_QUEUE=false y Redis en marcha (p. ej. docker run -d -p 6379:6379 redis:7-alpine)

GEMINI_API_KEY=
# Texto
GEMINI_MODEL=gemini-2.5-flash
# Imagen: modelo dedicado de Google para generación de imágenes
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

PLAYWRIGHT_HEADLESS=true
# Capturas y trazas Playwright al fallar tareas (worker)
# TASK_ARTIFACTS_DIR=./tmp/task-artifacts
# PLAYWRIGHT_TRACE_DIR=./tmp/playwright-traces
# LinkedIn suele funcionar mejor con Chrome instalado (no solo Chromium embebido):
# PLAYWRIGHT_CHANNEL=chrome
# Tras instalar Chrome/Edge: npx playwright install chrome   (o msedge)
# PLAYWRIGHT_LOCALE=es-ES
# PLAYWRIGHT_TIMEZONE=Europe/Madrid
# PLAYWRIGHT_SLOW_MO=80
# Menos esperas en automatización LinkedIn (solo desarrollo)
# En producción debe ser false — las esperas rápidas disparan detección de bots
LINKEDIN_FAST_AUTOMATION=false
# Minutos en «running» antes de reencolar (requiere migración 003 locked_at en tasks)
TASK_STALE_RUNNING_MINUTES=45
# Segundos: reencolar poll_comments en «running» (desbloquea visit/follow)
# Debe ser MAYOR que POLL_TASK_TIMEOUT_MS (p. ej. 90000) para no reencolar en bucle.
TASK_STALE_POLL_RUNNING_SEC=300
POLL_TASK_TIMEOUT_MS=90000
# Inbox: intentar primero sync por HTTP (Voyager + solo li_at; instantáneo en API). false = solo Playwright.
# INBOX_SYNC_TRY_HTTP_FIRST=true
# Inbox: cuántos hilos abrir por sync y tiempo (worker)
# INBOX_SYNC_MAX_THREADS=500
# Separación entre burbujas en BD cuando LinkedIn no da hora (ms)
# INBOX_THREAD_MESSAGE_STEP_MS=60000
# Scroll extra si falta la fila N en la lista virtualizada
# INBOX_LIST_EXTRA_SCROLL_WHEN_STUCK=28
# Mínimo de conversaciones leídas del DOM para no usar modo «clic por fila»
# INBOX_SYNC_BULK_MIN_ROWS=4
# Máx. adjuntos por hilo para capturar URL de descarga (Playwright)
# INBOX_THREAD_ATTACHMENT_URL_MAX=15
# Si sync_inbox lleva «running» más de estos segundos, se marca fallida al pedir sync de nuevo (libera dedupe)
# INBOX_SYNC_STALE_RUNNING_SEC=1200
# INBOX_SYNC_TIMEOUT_MS=0
# Si INBOX_SYNC_TIMEOUT_MS=0 o no está definido: max(360s, 80s + maxThreads * INBOX_SYNC_MS_PER_THREAD)
# INBOX_SYNC_MS_PER_THREAD=2600
# Espera extra para capturar JSON de Voyager (mensajes) tras abrir el hilo
# INBOX_VOYAGER_DRAIN_MS=1400
# 1 = insertar fila placeholder si no hay texto (por defecto 0: no llenar de “Hilo sincronizado…”)
# INBOX_THREAD_PLACEHOLDER=0
# Scroll lista conversaciones: pasos máximos por índice (virtualización)
# INBOX_LIST_ENSURE_MAX_STEPS=32
# Lista virtualizada LinkedIn: scroll hasta dejar de ver ids nuevos
# INBOX_LIST_COLLECT_CAP=220
# INBOX_LIST_SCROLL_ROUNDS=45
# INBOX_LIST_SCROLL_STABLE_ROUNDS=5
# INBOX_LIST_SCROLL_PAUSE_MS=140
# Modo clic (sin URLs en DOM): tope por fila antes de pasar a la siguiente
# INBOX_CLICK_INGEST_TIMEOUT_MS=55000
# false = no crear poll de keywords (prioriza campañas)
SCHEDULER_KEYWORD_POLLS=true
# Segundos entre encolados de poll_comments por cuenta (candado Redis; reduce actividad tipo “bot”).
# 43200 ≈ 2 veces/día (por defecto en código). 86400 ≈ 1 vez/día.
# SCHEDULER_KEYWORD_POLL_LOCK_SEC=43200
WORKER_POLL_MS=8000
# Tareas en paralelo por ciclo (máx. 4 navegadores)
WORKER_MAX_PARALLEL=1
# Logs por ciclo del worker: conteos pending/running (consola)
# WORKER_DEBUG=1
SCHEDULER_POLL_MS=3600000
WARMUP_INTERVAL_HOURS=18

# Lead finder: actor Apify pipelinelabs~lead-scraper-apollo-zoominfo-lusha-ppe (PPE; u otro con APIFY_LEAD_ACTOR)
# Token: https://console.apify.com/account/integrations
APIFY_TOKEN=
# APIFY_LEAD_ACTOR=pipelinelabs~lead-scraper-apollo-zoominfo-lusha-ppe
# Espera máx. del run en ms (por defecto 45 min; runs grandes pueden tardar más)
# APIFY_LEAD_MAX_WAIT_MS=2700000
# Máximo de filas a insertar por job (por defecto 2000)
# APIFY_LEAD_INSERT_CAP=2000

# Proxies Webshare.io (solo VPS/admin — no exponer al frontend)
# Usada por el script: npx tsx src/scripts/syncProxies.ts
WEBSHARE_API_KEY=
# Si true: rechaza ejecutar tareas de automatización sin proxy asignado (protege la IP del VPS)
REQUIRE_PROXY=true

# Horario laboral UTC para la automatización (no corre fuera de estas horas)
AUTOMATION_WORK_HOURS_START=7
AUTOMATION_WORK_HOURS_END=21
# Offset UTC de tu zona horaria (ej. España = 1, Argentina = -3)
# AUTOMATION_WORK_HOURS_UTC_OFFSET=0

# Cooldown entre acciones consecutivas por cuenta (simula tiempo humano entre clics)
ACCOUNT_COOLDOWN_MIN_SEC=180
ACCOUNT_COOLDOWN_MAX_SEC=480

PORT=3001
HOST=0.0.0.0

# Frontend (.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# En desarrollo, Next corre en :3030 (evita choque con otras apps en :3000). Deja NEXT_PUBLIC_API_URL vacío: el cliente usa /api y el proxy llega al backend :3001.
# Si llamas a la API desde SSR u otra app, define URL absoluta:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
# Destino del rewrite /api → backend (solo build/dev de Next)
# API_PROXY_TARGET=http://127.0.0.1:3001
